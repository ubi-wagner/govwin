        {
          "id": "e9310be3-80cf-4dd0-a18f-fe397517dafa",
          "nodes": [
            {
              "id": "5c65c094-c572-4aa7-8866-09907dc9e68b",
              "type": "text_block",
              "content": {
                "text": "Research Institution ({ri_name}). The {ri_lab} operates a calibrated acoustic test tank, a multi-element hydrophone array, a coastal test range with documented environmental characterization, and high-performance computing for propagation modeling. This provides representative undersea acoustic conditions and range data no small business could economically replicate — the core rationale for the STTR teaming.",
                "inline_formats": []
              },
              "style": {},
              "provenance": {
                "source": "manual"
              },
              "history": [],
              "library_eligible": false
            }
