        {
          "id": "f711b229-637b-4a09-b339-235c24b959ea",
          "label": "Figure 2 — Aerivio facility",
          "keep_together": true,
          "nodes": [
            {
              "id": "c283b067-652e-4a10-a92e-ed5fdd66447c",
              "type": "image",
              "content": {
                "storage_key": "data:image/svg+xml;base64,",
