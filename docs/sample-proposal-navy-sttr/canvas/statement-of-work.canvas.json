      "type": "heading",
      "content": {
        "level": 3,
        "text": "Task 6 — Hardware-in-the-Loop Node Prototype (SBC, Months 19–22)"
      },
      "style": {
        "color": "#155e75"
      },
      "provenance": {
        "source": "manual"
