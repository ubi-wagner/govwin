    {
      "id": "a707f928-18c6-4e20-95c0-dd3b89d8f3a1",
      "type": "bulleted_list",
      "content": {
        "items": [
          {
            "text": "Quantization-aware training to 4-bit weights with <1.5-point accuracy loss"
          },
          {
            "text": "Saliency-guided structured pruning — removes ~70% of parameters (patent pending)"
          },
          {
            "text": "Deterministic sub-watt runtime — guaranteed p99 latency at a fixed power budget"
          },
          {
            "text": "Result: an accurate maritime classifier in a 2-watt envelope"
          }
        ]
      },
      "style": {},
