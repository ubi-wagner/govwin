      "content": {
        "items": [
          {
            "text": "Small business building power-efficient, on-device AI for defense maritime autonomy"
          },
          {
            "text": "Founded by low-power ML and embedded-systems engineers"
          },
          {
            "text": "Core competency: compressing accurate acoustic classifiers to single-digit-watt edge modules"
          },
          {
            "text": "Mission: put reliable classification where connectivity fails — the contested edge"
          }
