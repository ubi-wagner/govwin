            {
              "id": "6cf1db56-5619-46e7-9c5a-f666dc0dc1ca",
              "type": "bulleted_list",
              "content": {
                "items": [
                  {
                    "text": "Incumbents process acoustics shore-side → latency + comms dependence"
                  },
                  {
                    "text": "Aerivio runs fully on-vessel at 2 watts, <100 ms"
                  },
                  {
                    "text": "Defensible IP: saliency-guided quantization pipeline (patent pending)"
                  },
                  {
                    "text": "Retrofits deployed hulls — no new hardware program required"
                  }
                ]
              },
              "style": {},
              "provenance": {
                "source": "manual"
              },
              "history": [],
              "library_eligible": false
            },
            {
              "id": "009e1143-266f-4f62-a858-71e42b584def",
              "type": "text_block",
              "content": {
                "text": "Bottom line: we win where connectivity fails — exactly the contested environment that matters.",
