      "content": {
        "items": [
          {
            "text": "Incumbents process acoustics shore-side → latency + comms dependence"
          },
          {
            "text": "Aerivio runs fully on-vessel at 2 watts, <100 ms"
          },
          {
            "text": "Defensible IP: saliency-guided quantization pipeline (patent pending)"
          },
          {
            "text": "Retrofits deployed hulls — no new hardware program required"
          }
        ]
      },
