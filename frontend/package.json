{
  "name": "rfp-pipeline-portal",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "seed:gen": "DATABASE_URL=postgresql://gen@localhost/gen tsx scripts/gen-page-seeds.ts",
    "prebuild": "npm run sync:pdf-worker && (npm run seed:gen || echo '[prebuild] page-seeds snapshot skipped (using committed JSON)')",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "vitest run --passWithNoTests --exclude __tests__/integration/**",
    "test:unit": "vitest run --passWithNoTests __tests__/api-guards.test.ts __tests__/middleware.test.ts",
    "test:integration": "vitest run --passWithNoTests __tests__/integration/",
    "test:e2e": "playwright test",
    "architecture": "node scripts/architecture/extract.mjs && node scripts/architecture/generate.mjs",
    "architecture:render": "node scripts/architecture/generate.mjs",
    "sync:pdf-worker": "node scripts/sync-pdf-worker.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@aws-sdk/client-s3": "^3.1026.0",
    "@aws-sdk/s3-request-presigner": "^3.1026.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "bcryptjs": "^2.4.3",
    "docx": "^9.6.1",
    "exceljs": "^4.4.0",
    "googleapis": "^171.4.0",
    "htmlparser2": "^12.0.0",
    "mammoth": "^1.12.0",
    "next": "^15.5.14",
    "next-auth": "^5.0.0-beta.25",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.6.205",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.3",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-pdf": "^10.4.1",
    "stripe": "^17.0.0",
    "tesseract.js": "^7.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.10.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/ui": "^4.1.3",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.56.0",
    "eslint-config-next": "^15.5.14",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.3"
  }
}
